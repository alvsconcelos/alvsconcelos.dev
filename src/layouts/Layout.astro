---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import { site, type Copy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;
const canonical = new URL(copy.localePath, site.url).href;
const alternate = new URL(copy.alternatePath, site.url).href;
const ogImage = new URL(locale === 'en' ? '/og-en.png' : '/og-pt.png', site.url).href;
const photo = new URL(site.image, site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url + '/',
  image: photo,
  jobTitle: 'Engineering Manager',
  worksFor: {
    '@type': 'Organization',
    name: 'Housecall Pro',
    url: 'https://www.housecallpro.com',
  },
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'BR',
  },
  sameAs: [
    site.linkedin,
    site.github,
    'https://wordpress.org/plugins/calculo-do-frete-somente-com-o-cep-wc-brasil/',
    'https://wordpress.org/plugins/add-multiple-products-to-cart-via-url-for-woocommerce/',
  ],
};
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', site.url).href} />
    <link rel="alternate" hreflang="pt-BR" href={new URL('/pt/', site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={copy.ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F6F3EE" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#content">{copy.skip}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={copy.localePath}>{site.name}</a>
        <nav class="header-nav" aria-label="Primary">
          <a href="#work">{copy.nav.work}</a>
          <a href="#now">{copy.nav.now}</a>
          <a href="#resume">{copy.nav.resume}</a>
          <a href="#contact">{copy.nav.contact}</a>
        </nav>
        <div class="lang" aria-label="Language">
          <a href="/" lang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href="/pt/" lang="pt-BR" aria-current={locale === 'pt' ? 'true' : undefined}>PT</a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {copy.footer}</p>
        <p><a href={copy.localePath}>alvsconcelos.dev</a></p>
      </div>
    </footer>
  </body>
</html>
