---
import Layout from '../layouts/Layout.astro';
import { site, type Copy, type Locale } from '../content/copy';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;
---

<Layout locale={locale} copy={copy}>
  <main id="content" class="wrap">
    <div class="page">
      <section class="hero" aria-labelledby="hero-name">
        <img
          class="portrait"
          src={site.image}
          alt={copy.hero.photoAlt}
          width="88"
          height="88"
        />
        <div class="hero-copy">
          <h1 id="hero-name">{site.name}</h1>
          <p class="role">{copy.hero.role}</p>
          <p class="lede">{copy.hero.intro}</p>
          <div class="ctas">
            <a class="btn btn-primary" href="#contact">{copy.hero.contactCta}</a>
            <a class="btn btn-secondary" href="#resume">{copy.hero.resumeCta}</a>
          </div>
        </div>
      </section>

      <section class="section" id="what-i-do" aria-labelledby="focus-heading">
        <h2 class="section-label" id="focus-heading">{copy.focus.heading}</h2>
        <ul class="focus-list">
          {copy.focus.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="section" id="work" aria-labelledby="work-heading">
        <h2 class="section-label" id="work-heading">{copy.work.heading}</h2>
        <div class="cases">
          {copy.work.cases.map((item) => (
            <details class="case" id={item.id} name="selected-work">
              <summary>
                <span class="case-heading">
                  <span class="case-title">{item.title}</span>
                  <span class="case-summary">{item.summary}</span>
                </span>
                <span class="case-toggle" aria-hidden="true"></span>
              </summary>
              <div class="case-body">
                <p>
                  <strong>{copy.caseLabels.problem}</strong>
                  {item.problem}
                </p>
                <p>
                  <strong>{copy.caseLabels.did}</strong>
                  {item.did}
                </p>
                <p>
                  <strong>{copy.caseLabels.outcome}</strong>
                  {item.outcome}
                </p>
                {item.links && item.links.length > 0 && (
                  <p class="case-links">
                    {item.links.map((link) => (
                      <a href={link.href} rel="noopener noreferrer">
                        {link.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section class="section" id="now" aria-labelledby="now-heading">
        <h2 class="section-label" id="now-heading">{copy.now.heading}</h2>
        <p>{copy.now.text}</p>
      </section>

      <section class="section close" id="resume" aria-labelledby="resume-heading">
        <h2 class="section-label" id="resume-heading">{copy.resume.heading}</h2>
        <p class="resume-row">
          <a href="/Alvaro-Vasconcelos-Resume-EN.pdf">{copy.resume.enLabel}</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href="/Alvaro-Vasconcelos-Curriculo-PT.pdf">{copy.resume.ptLabel}</a>
        </p>
      </section>

      <section class="section close" id="contact" aria-labelledby="contact-heading">
        <h2 class="section-label" id="contact-heading">{copy.contact.heading}</h2>
        <ul class="contact-list">
          <li>
            <span>{copy.contact.emailLabel}</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span>{copy.contact.linkedinLabel}</span>
            <a href={site.linkedin} rel="noopener noreferrer">linkedin.com/in/alvsconcelos</a>
          </li>
          <li>
            <span>{copy.contact.githubLabel}</span>
            <a href={site.github} rel="noopener noreferrer">github.com/alvsconcelos</a>
          </li>
        </ul>
      </section>
    </div>
  </main>
</Layout>
